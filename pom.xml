<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.9</version>
    <relativePath/>
  </parent>

  <groupId>org.aisa</groupId>
  <artifactId>aisa-api</artifactId>
  <version>1.0.0</version>
  <name>AISA API</name>
  <description>Backend for the AIML Student Association site, BSIET Kolhapur</description>

  <properties>
    <firebase.auth.emulator.host>127.0.0.1:9099</firebase.auth.emulator.host>
    <firestore.emulator.host>127.0.0.1:8085</firestore.emulator.host>
    <java.version>25</java.version>
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <lombok.version>1.18.38</lombok.version>
    <cloudinary.version>1.39.0</cloudinary.version>
    <firebase.admin.version>9.4.3</firebase.admin.version>
    <springdoc.version>2.8.4</springdoc.version>
  </properties>

  <dependencies>
    <!-- Web + validation. Validation is a starter, not a transitive freebie: without it
         @Valid on a controller argument is silently ignored and bad payloads reach the
         service layer. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Schema is versioned in db/migration and applied on boot. ddl-auto is set to
         'validate' everywhere, so Flyway is the ONLY thing allowed to change the schema. -->

    <!-- Reads .env into the Spring Environment so local dev and the deployed container
         are configured the same way (see docs/deployment.md). -->
    <dependency>
      <groupId>me.paulschwarz</groupId>
      <artifactId>spring-dotenv</artifactId>
      <version>4.0.0</version>
    </dependency>

    <!-- Firestore, via the Firebase Admin SDK. Pulls google-cloud-firestore transitively;
         using the Firebase artifact rather than the bare GCP one keeps credential handling
         identical to the console the admins already use. -->
    <dependency>
      <groupId>com.google.firebase</groupId>
      <artifactId>firebase-admin</artifactId>
      <version>${firebase.admin.version}</version>
    </dependency>

    <dependency>
      <groupId>com.cloudinary</groupId>
      <artifactId>cloudinary-http44</artifactId>
      <version>${cloudinary.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- Tests run against a real Postgres in Docker. An H2 stand-in would pass on SQL
         that Postgres rejects, which is the exact class of bug integration tests exist
         to catch. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Keeps constructor parameter names in the bytecode. Spring binds
               @RequestParam and constructor-injected beans by name; without this the
               names become arg0/arg1 and binding fails at runtime, not at build time. -->
          <parameters>true</parameters>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>

      <!--
        FIREBASE_AUTH_EMULATOR_HOST has to be a real environment variable, not a system
        property: the Firebase Admin SDK reads it with System.getenv, which no code inside
        a running JVM can write to. Surefire forks the test JVM, so this is the only place
        it can be set.

        Without it, tests verify their ID tokens against Google's real public keys, every
        emulator-minted token is rejected, and every authenticated test fails with a 401
        that names nothing.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <environmentVariables>
            <FIREBASE_AUTH_EMULATOR_HOST>${firebase.auth.emulator.host}</FIREBASE_AUTH_EMULATOR_HOST>
            <FIRESTORE_EMULATOR_HOST>${firestore.emulator.host}</FIRESTORE_EMULATOR_HOST>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
