# ─────────────────────────────────────────────────────────────────────────────
# AISA API — environment.
#
# Copy to `.env` (git-ignored) for local development; set the same keys as
# environment variables on your host for production. spring-dotenv loads `.env`
# into the Spring Environment automatically, so `application.yml` reads one set of
# names in both places.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# `docker compose up -d db` serves exactly this. On Render, paste the Internal
# Database URL and convert it to JDBC form: jdbc:postgresql://HOST:5432/DBNAME
DATABASE_URL=jdbc:postgresql://localhost:5432/aisa
DATABASE_USERNAME=aisa
DATABASE_PASSWORD=aisa

# ── JWT signing key (REQUIRED — the app refuses to start without it) ────────
# Must be at least 32 bytes, base64-encoded. Generate one:
#   openssl rand -base64 48
# Rotating this value invalidates every issued admin token, which is the intended
# way to revoke a leaked session.
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ISSUER=aisa-api
JWT_ACCESS_TTL=PT12H

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated exact origins. The frontend is a static site on another origin,
# so the browser will not send a single request that is not listed here.
# Production example:
#   https://<github-user>.github.io,https://aisa.example.org
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── First admin ─────────────────────────────────────────────────────────────
# Created on first boot only, and only if the admin table is empty. Leave the
# password blank in production and set it once via the host's secret manager;
# the app logs a warning and creates no admin if it is unset.
ADMIN_BOOTSTRAP_USERNAME=AISA2026
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_DURATION=PT15M

# ── Cloudinary (image hosting) ──────────────────────────────────────────────
# Dashboard → Settings → API Keys. The api-secret NEVER reaches the browser: the
# frontend asks this API for a short-lived upload signature instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aisa

# ── Misc ────────────────────────────────────────────────────────────────────
CONTACT_RATE_LIMIT=5
DB_POOL_SIZE=5
LOG_LEVEL=INFO
# PORT is injected by the host (Render sets it). Only set it locally if 8080 clashes.
# PORT=8080
